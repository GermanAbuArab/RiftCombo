{
  "name": "riftcombo",
  "version": "0.1.0",
  "private": true,
  "description": "Combo finder and visualizer for Riftbound TCG",
  "type": "module",
  "scripts": {
    "build:data": "node scripts/build-cards.mjs && node scripts/build-corpus.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "find": "tsx src/cli.ts",
    "build:web": "node scripts/build-web.mjs",
    "dev": "node scripts/build-web.mjs && vercel dev",
    "deploy": "vercel deploy --prod",
    "deploy:preview": "vercel deploy",
    "synergies": "tsx src/cli-synergies.ts",
    "headers": "node scripts/build-headers.mjs",
    "check:rls": "node scripts/check-rls.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@piltoverarchive/riftbound-deck-codes": "^1.4.0",
    "@supabase/supabase-js": "^2.115.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
