  "cards": [
    {
      "dot": "cyan",
      "title": "The match path",
      "items": [
        "cards.json is built from Riot's gallery API; no mirror is ever a source of card text",
        "CardIndex.equivalents() folds a base code onto every printing sharing its name and type",
        "generateVariants flattens needs/produces, then matchDeck sorts every variant into six buckets"
      ]
    },
    {
      "dot": "emerald",
      "title": "Authored, not generated",
      "items": [
        "715 combo entries and 197 synergy rules are hand-written",
        "The 81 walk documents under docs/phase0/walks are their evidence",
        "A synergy rule is verified once by hand; its instances are matched by text"
      ]
    },
    {
      "dot": "rose",
      "title": "Edges that failed silently",
      "items": [
        "A field src/ reads and WEB_CARD_FIELDS omits is undefined in production, green in every test",
        "vercel.json is generated by build-headers.mjs and committed, never hand-edited",
        "public/ is gitignored build output; api/deck-url.ts is the only code on a server"
      ]
    }
  ]
}